# =============================================================================
# ZelaAi — variáveis de ambiente (exemplo)
# Copie para .env (que é ignorado pelo git) e ajuste o que precisar.
# =============================================================================

# ---------------------- Backend ----------------------
# Connection string Postgres no formato "key=value"
DATABASE_URL=host=localhost port=5432 user=postgres dbname=postgres password=root

# Segredo HMAC para assinar JWTs. TROQUE em produção.
JWT_SECRET=zelaai_dev_secret

# ---------------------- Docker compose ---------------
# Senha do Postgres que sobe no container (default: postgres)
POSTGRES_PASSWORD=postgres
