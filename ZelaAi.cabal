cabal-version:      3.0
name:               ZelaAi
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Albert and Lorenzo
maintainer:         albertstanley927@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MyLib
                    , Api
                    , Db
                    , Repository.Entities
                    , Repository.Generic
                    , Dto.UserDto
                    , Dto.CategoryDto
                    , Dto.OccurrenceDto
                    , Dto.VoteDto
                    , Dto.MandateDto
                    , Dto.ResponseDto
                    , Validation.UserValidation
                    , Validation.OccurrenceValidation
                    , Validation.MandateValidation
                    , UseCase.UserCase
                    , UseCase.CategoryCase
                    , UseCase.OccurrenceCase
                    , UseCase.VoteCase
                    , UseCase.MandateCase
                    , UseCase.ScoreCase
                    , Presentation.Controllers
                    , Presentation.Auth
                    , Presentation.Binding
                    , Presentation.Responses
                    , Presentation.Errors
                    , InterfaceAdapters.Libs
                    , InterfaceAdapters.Apis
                    , InterfaceAdapters.Logs
                    , InterfaceAdapters.Mapping
    build-depends:    base ^>=4.18.3.0
                    , servant
                    , servant-server
                    , warp
                    , wai
                    , wai-cors
                    , aeson
                    , persistent
                    , persistent-postgresql
                    , persistent-template
                    , monad-logger
                    , mtl
                    , transformers
                    , bytestring
                    , text
                    , time
                    , containers
                    , bcrypt
                    , jwt
                    , uuid
                    , http-client
                    , http-client-tls
                    , http-types
    hs-source-dirs:   src
    default-language: GHC2021

executable ZelaAi
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.3.0
                    , ZelaAi
    ghc-options:      -threaded
    hs-source-dirs:   app
    default-language: Haskell2010
